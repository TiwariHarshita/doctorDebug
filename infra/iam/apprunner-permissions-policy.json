{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublishEventArchiveMessages",
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": "REPLACE_WITH_EVENT_ARCHIVE_QUEUE_ARN"
    },
    {
      "Sid": "DownloadEventArchives",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "REPLACE_WITH_EVENT_ARCHIVE_BUCKET_ARN/events/*"
    }
  ]
}
